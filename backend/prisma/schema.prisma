generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id String @id @default(cuid())

  email        String @unique
  passwordHash String

  firstName  String
  middleName String?
  lastName   String

  tests Test[]
}

model Test {
  id      String @id @default(cuid())
  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String
}
