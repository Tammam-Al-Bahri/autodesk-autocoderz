model Room {
  id String @id @default(cuid())

  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId String

  number String
  type   RoomType
  status RoomStatus

  tickets Ticket[]
}

enum RoomType {
  SINGLE
  DOUBLE
}

enum RoomStatus {
  OCCUPIED
  AVAILABLE
}
