{
    "name": "autodesk-autocoderz",
    "version": "1.0.0",
    "scripts": {
        "dev:backend": "npm --prefix backend run dev",
        "dev:frontend": "npm --prefix frontend run dev",
        "dev:shared": "npm --prefix packages/shared run dev",
        "dev": "concurrently -k -n BACKEND,FRONTEND,SHARED -c blue,green,yellow \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:shared\"",
        "db": "npm --prefix backend run db"
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    }
}
